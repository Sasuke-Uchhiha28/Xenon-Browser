# Line-ending policy: this repository builds on Windows and Linux and
# contains bash hooks and CI scripts, so text files are LF everywhere.
* text=auto eol=lf

# Windows-only script types keep CRLF in the working tree.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets (never normalized)
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
